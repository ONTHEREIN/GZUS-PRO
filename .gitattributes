# 统一换行符规范：文本文件入库标准化为 LF，避免 CRLF 往返产生全文件假 diff
* text=auto

*.md    text eol=lf
*.dart  text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.xml   text eol=lf
*.ps1   text eol=crlf

# 二进制资源
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.wasm  binary
*.jar   binary
*.keystore binary
