# ============================================================
# 软帮手 OneGZUS — 服务器生产环境变量模板
# 部署位置：/opt/onegzus/shared/api.env
# 由 services/api/.env.example 派生，按腾讯云自托管场景调整。
# 填写完成后复制为 /opt/onegzus/shared/api.env（不要提交到仓库）。
# ============================================================

# ─── 基础 ───────────────────────────────────────────────────
DEBUG=false

# ─── 数据库（服务器本机 PostgreSQL）─────────────────────────
# 用户名/密码/库名与 setup_server.sh 创建的保持一致
DATABASE_URL=postgresql://onegzus:CHANGE_ME_PG_PASSWORD@127.0.0.1:5432/onegzus
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# ─── 密钥（迁移时务必保持与旧生产一致）─────────────────────
# CREDENTIAL_ENCRYPTION_KEY：会话里用户凭证的 Fernet 加密密钥。
#   更换会导致历史凭证无法解密 → 所有用户重新登录。
#   生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_MUST_MATCH_OLD_PRODUCTION

# INTERNAL_API_KEY：仅供服务器本机 /internal/cron/* 端点鉴权。
INTERNAL_API_KEY=CHANGE_ME_RANDOM

# 可选：RSA 私钥 PEM（登录密码解密）。不配置则每次启动自动生成新密钥对，
#   前端登录前会实时拉取公钥，影响很小；如需跨重启稳定可配置固定私钥：
#   openssl genrsa 2048 | base64 -w0   （把输出整行粘到下一行）
# RSA_PRIVATE_KEY_PEM=

# ─── 对外地址（必须是 HTTPS；nginx 会剥掉 /api 前缀）────────
PUBLIC_API_BASE_URL=https://onegzus.example.com/api
FRONTEND_BASE_URL=https://onegzus.example.com

# CORS：前端域名会自动加入白名单（由 FRONTEND_BASE_URL 推导）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080,https://onegzus.example.com
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3})(:\d+)?$

# ─── 学校系统（保持默认即可，无需改动）─────────────────────
JW_BASE_URL=https://jwxt.gzus.edu.cn/jwglxt
EHALL_BASE_URL=https://ehall.gzus.edu.cn
EHALL_STAFF_SYNC_URL=
EHALL_STAFF_JSON_PATH=
CAS_LOGIN_URL=https://cas.gzus.edu.cn/lyuapServer/login
EHALL_SERVICE_URL=http://ehall.gzus.edu.cn/shiro-cas
JWXT_SSO_SERVICE_URL=https://jwxt.gzus.edu.cn/sso/lyiotlogin
ECARD_BASE_URL=https://ecarduser.gzus.edu.cn
ECARD_OPENID=
ECARD_UNIONID=
ECARD_SECRET=
ECARD_VERIFY_TLS=true
EHALL_CSRF_KEY=

# ─── 会话 / 超时 / 限流 ─────────────────────────────────────
SESSION_TTL_SECONDS=7200
SSO_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15
WS_HEARTBEAT_SECONDS=30

# ─── 推送 ───────────────────────────────────────────────────
# VAPID 密钥务必与迁移前一致，否则已订阅用户推送失效
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:example@example.com
PUSH_POLL_INTERVAL_SECONDS=1800
# 后台轮询器在服务器上常驻运行
ECARD_DAILY_REMINDER_HOUR=8
ECARD_DAILY_REMINDER_MINUTE=0

# ─── 管理后台 ───────────────────────────────────────────────
# 首个 owner 学号（逗号分隔，可多个）；启动时幂等写入 admin_users 表
ADMIN_SEED_OWNER=

# ─── 公众号文章同步 ─────────────────────────────────────────
# 微信「合集」链接（含 __biz 与 album_id），匿名通道。
# 获取方法：手机微信打开你的公众号 → 公众号后台「内容与互动 → 合集」→
#   在合集页点右上角「···」→ 复制链接，形如：
#   https://mp.weixin.qq.com/mp/appmsgalbum?__biz=xxxx&action=getalbum&album_id=123
# 或电脑端公众号后台合集管理里复制合集链接。填此项即可启用匿名同步。
WECHAT_ALBUM_URL=
# wechatrss 订阅源完整 URL（含 token；私人密钥，勿提交仓库）。
# 配置后优先于合集通道；需要第三方 wechatrss 服务订阅源
WECHAT_RSS_URL=
WECHAT_SYNC_INTERVAL_HOURS=6

# ─── 应用更新信息（沿用现有值）──────────────────────────────
APP_LATEST_VERSION=0.1.1
APP_LATEST_BUILD=4
APP_MIN_SUPPORTED_VERSION=0.0.1
APP_MIN_SUPPORTED_BUILD=1
APP_DOWNLOAD_URL=
APP_RELEASE_NOTES=
