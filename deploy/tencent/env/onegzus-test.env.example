# ============================================================
# 软帮手 OneGZUS — 小程序测试环境变量模板
# 部署位置：/opt/onegzus-test/shared/api.env
# 由 onegzus.env.example（生产）派生，差异点都写在注释里。
# 填写后复制到服务器，权限 600，绝不提交仓库。
# ============================================================

# ─── 基础：测试环境必须开 DEBUG ──────────────────────────────
# DEMO_ACCOUNT_ENABLED 依赖 DEBUG=true，config.py 会强制校验。
DEBUG=true

# ─── 数据库：独立库，绝不指向生产库 ─────────────────────────
# 建库：sudo -u postgres createdb onegzus_test -O onegzus
DATABASE_URL=postgresql://onegzus:CHANGE_ME_TEST_PG_PASSWORD@127.0.0.1:5432/onegzus_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# ─── 密钥：必须与生产**不同** ───────────────────────────────
# 复用生产密钥会让测试库里的密文具备被生产密钥解开的可能，务必单独生成：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_TEST_ONLY_RANDOM
INTERNAL_API_KEY=CHANGE_ME_TEST_ONLY_RANDOM

# ─── 对外地址：测试子域名 ───────────────────────────────────
PUBLIC_API_BASE_URL=https://test-api.onegzus.onrein.top/api
FRONTEND_BASE_URL=https://test-api.onegzus.onrein.top
CORS_ORIGINS=https://test-api.onegzus.onrein.top
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# ─── 演示账号（小程序验收用）───────────────────────────────
# 密码只存在于本文件；不要在群里、工单或自动化日志里传播。
DEMO_ACCOUNT_ENABLED=true
DEMO_ACCOUNT=CHANGE_ME_DEMO_ACCOUNT
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
DEMO_STUDENT_ID=DEMO-2026-001

# ─── 学校系统：测试环境不接真实系统 ─────────────────────────
# 演示账号走 app/demo_data.py 的本地 fixture，不会发起任何学校请求。
# 保持默认值即可；若配置了 ECARD_SECRET 等真实凭据，请确认真实学生账号不会被使用。
JW_BASE_URL=https://jwxt.gzus.edu.cn/jwglxt
EHALL_BASE_URL=https://ehall.gzus.edu.cn
CAS_LOGIN_URL=https://cas.gzus.edu.cn/lyuapServer/login
CAS_PASSWORD_CHANGE_URL=https://cas.gzus.edu.cn/aqzx/#/password/passwordModify
EHALL_SERVICE_URL=http://ehall.gzus.edu.cn/shiro-cas
JWXT_SSO_SERVICE_URL=https://jwxt.gzus.edu.cn/sso/lyiotlogin
ECARD_BASE_URL=https://ecarduser.gzus.edu.cn
ECARD_OPENID=
ECARD_UNIONID=
ECARD_SECRET=
ECARD_VERIFY_TLS=true
EHALL_CSRF_KEY=

# ─── 会话 / 超时 / 限流 ─────────────────────────────────────
SESSION_TTL_SECONDS=3600
SSO_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15

# ─── 推送：测试环境关闭，避免打扰真实用户 ───────────────────
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8_BASE64=
APNS_BUNDLE_ID=
PUSH_POLL_INTERVAL_SECONDS=3600

# ─── 管理后台：测试环境不设管理员 ───────────────────────────
ADMIN_SEED_OWNER=

# ─── 公众号同步：测试环境关闭 ───────────────────────────────
WECHAT_ALBUM_URL=
WECHAT_ALBUM_URLS=
WECHAT_RSS_URL=
WECHAT_SYNC_INTERVAL_HOURS=24
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
