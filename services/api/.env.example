DB_POOL_SIZE=1
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
ECARD_BASE_URL=https://ecarduser.gzus.edu.cn
ECARD_OPENID=
ECARD_UNIONID=
ECARD_SECRET=
ECARD_VERIFY_TLS=true
ECARD_DAILY_REMINDER_HOUR=8
ECARD_DAILY_REMINDER_MINUTE=0
