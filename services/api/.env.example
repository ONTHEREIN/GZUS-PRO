JW_BASE_URL=https://jwxt.gzus.edu.cn/jwglxt
EHALL_BASE_URL=https://ehall.gzus.edu.cn
EHALL_STAFF_SYNC_URL=
EHALL_STAFF_JSON_PATH=
CAS_LOGIN_URL=https://cas.gzus.edu.cn/lyuapServer/login
EHALL_SERVICE_URL=http://ehall.gzus.edu.cn/shiro-cas
JWXT_SSO_SERVICE_URL=https://jwxt.gzus.edu.cn/sso/lyiotlogin
PUBLIC_API_BASE_URL=https://onegzus.onrein.top/api
FRONTEND_BASE_URL=https://onegzus.onrein.top
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080,https://onegzus.onrein.top
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3})(:\d+)?$
SESSION_TTL_SECONDS=7200
SSO_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=15
PUSH_POLL_INTERVAL_SECONDS=300
BACKGROUND_NOTIFICATION_POLL_INTERVAL_SECONDS=300
COURSE_REMINDER_DISPATCH_INTERVAL_SECONDS=60
WS_HEARTBEAT_SECONDS=30
DEBUG=false
# 必填：使用 Neon/Supabase 等 PostgreSQL 连接串；文件型 SQLite 不再支持
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
ECARD_BASE_URL=https://ecarduser.gzus.edu.cn
ECARD_OPENID=
ECARD_UNIONID=
ECARD_SECRET=
ECARD_VERIFY_TLS=true
ECARD_DAILY_REMINDER_HOUR=8
ECARD_DAILY_REMINDER_MINUTE=0
EHALL_CSRF_KEY=
APP_LATEST_VERSION=0.1.1
APP_LATEST_BUILD=4
APP_MIN_SUPPORTED_VERSION=0.0.1
APP_MIN_SUPPORTED_BUILD=1
APP_DOWNLOAD_URL=
APP_RELEASE_NOTES=
CREDENTIAL_ENCRYPTION_KEY=change-this-to-a-random-32-byte-string
# 管理后台首个 owner 学号（逗号分隔，可多个）；启动时幂等写入 admin_users 表
ADMIN_SEED_OWNER=
# 微信公众号「合集」链接（含 __biz 与 album_id），如：
# https://mp.weixin.qq.com/mp/appmsgalbum?__biz=xxx&action=getalbum&album_id=123
# 通过公开合集接口匿名拉取文章列表（标题/封面/链接/发布时间），无需 AppID/Secret；空=该通道关闭
WECHAT_ALBUM_URL=
# wechatrss 第三方 RSS 服务订阅源完整 URL（含 token）。配置后优先于合集通道；
# token 为私人密钥：仅存环境变量，后端对日志/API 响应一律脱敏，不要提交到代码仓库
WECHAT_RSS_URL=
# 公众号文章自动同步间隔（小时）；cron 定时 + 读通知时的惰性兜底都遵循此间隔
WECHAT_SYNC_INTERVAL_HOURS=6
# Apple Developer 的 APNs Auth Key（.p8）配置。私钥使用 `base64 < AuthKey_*.p8 | tr -d '\n'` 后的单行值，
# 仅保存到生产服务器 /opt/onegzus/shared/api.env，绝不提交到仓库。
APNS_KEY_ID=
APNS_TEAM_ID=6772C5TF6C
APNS_KEY_P8_BASE64=
APNS_BUNDLE_ID=cn.gzus.pro.6863N22CPT
# Web Push 使用 py-vapid 生成的未填充 Base64URL P-256 私钥；公钥由服务端派生，
# 不要填写 PEM 公钥。
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
