page {
  background: #f5f7fb;
  color: #1f2a3d;
  font-size: 28rpx;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(47, 76, 128, 0.06);
}

.page-title {
  margin: 10rpx 0 28rpx;
  color: #17243b;
  font-size: 44rpx;
  font-weight: 700;
}

.muted {
  color: #748094;
  font-size: 25rpx;
}

.empty {
  padding: 80rpx 30rpx;
  color: #748094;
  text-align: center;
}
