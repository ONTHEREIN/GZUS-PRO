.notice-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.source { padding: 6rpx 12rpx; border-radius: 10rpx; background: #e7f0ff; color: #2176e8; font-size: 22rpx; }
.notice-title { color: #1d2b42; font-size: 31rpx; font-weight: 700; line-height: 1.45; }
.notice-summary { display: -webkit-box; overflow: hidden; margin-top: 12rpx; color: #66758c; font-size: 25rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.error { color: #c62828; }
