<view class="page login-page" id="login-page">
  <view class="brand">
    <view class="brand-mark">软</view>
    <view>
      <view class="brand-title">软帮手</view>
      <view class="brand-subtitle">广州软件学院教务助手</view>
    </view>
  </view>

  <view class="card form-card">
    <block wx:if="{{!existingSession}}">
      <view class="field-label">学号</view>
      <input id="login-account" class="input" placeholder="请输入学号" value="{{account}}" bindinput="onAccountInput" />
      <view class="field-label">统一认证密码</view>
      <input id="login-password" class="input" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
      <checkbox-group id="login-background-consent" bindchange="onBackgroundConsentChange"><label><checkbox id="login-background-checkbox" value="background" checked="{{backgroundConsent}}" />绑定当前微信，并授权服务端加密保存登录凭据，用于退出小程序后的后台提醒（可在提醒设置中撤销）</label></checkbox-group>
    </block>
    <checkbox-group id="login-agreement" bindchange="onAgreementChange"><label><checkbox id="login-agree-checkbox" value="agree" checked="{{agreed}}" />我已阅读并同意</label></checkbox-group>
    <view class="agreement-links"><text id="login-terms" bindtap="openTerms">《用户服务协议》</text><text id="login-privacy" bindtap="openPrivacy">《隐私政策》</text></view>
    <view wx:if="{{error}}" id="login-error" class="error">{{error}}</view>
    <button wx:if="{{existingSession}}" id="login-continue" loading="{{submitting}}" bindtap="continueSession">同意并继续</button>
    <button wx:if="{{!existingSession}}" id="login-submit" class="login-button" loading="{{submitting}}" bindtap="submit">登录</button>
    <button wx:if="{{!existingSession}}" id="login-wechat" class="wechat-button" loading="{{wechatSubmitting}}" bindtap="wechatLogin">微信一键登录</button>
  </view>

  <view class="notice">密码不会保存在小程序本地。勾选后台提醒授权后，登录凭据仅在服务端加密保存；微信消息仍需另行订阅。</view>
</view>
