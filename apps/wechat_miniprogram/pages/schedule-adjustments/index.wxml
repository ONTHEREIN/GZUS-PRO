<template name="courses">
  <view wx:if="{{count === 0}}" class="muted">没有课程</view>
  <view wx:for="{{rows}}" wx:key="itemKey" class="time-block"><view class="course-time">{{item.date}} · 第{{item.startSection}}–{{item.endSection}}节</view><view class="course-name">{{item.name}}</view><view class="muted">{{item.classroom}} {{item.teacher}}</view></view>
</template>
<template name="comparison">
  <view class="comparison"><view class="side"><view class="title">调整前</view><template is="courses" data="{{rows: before, count: beforeCount}}" /></view><view class="side"><view class="title">调整后</view><template is="courses" data="{{rows: after, count: afterCount}}" /></view></view>
</template>
<view class="page adjustments" id="adjustments-page">
  <view class="header"><button id="adjustment-back" size="mini" bindtap="back">×</button><view class="title">{{screen === 'history' ? '调课记录' : screen === 'restore' ? '撤销预览' : screen === 'preview' ? '调整预览' : '调课'}}</view><button id="adjustment-entry-history" size="mini" data-screen="history" bindtap="enter">记录 {{activeCount}}</button><button wx:if="{{screen === 'course' && step < 2}}" id="adjustment-primary" class="header-primary" bindtap="nextStep" disabled="{{busy || !selectedCount}}">{{step === 0 ? '选择范围' : '新时间'}}</button><button wx:if="{{screen === 'day' || (screen === 'course' && step === 2)}}" id="adjustment-primary" class="header-primary" bindtap="makePreview" disabled="{{busy || !loaded || validation}}">查看预览</button></view>
  <view class="muted">{{periodLabel}}</view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:if="{{error}}" id="adjustments-error" class="card error">{{error}}<button id="adjustment-reload" size="mini" bindtap="loadPage" disabled="{{busy}}">重新加载</button></view>
  <button wx:if="{{invalidCount}}" id="adjustment-clear-invalid" bindtap="clearInvalid">清除{{invalidCount}}个失效选择，保留其他课程</button><view wx:if="{{screen === 'course' || screen === 'day'}}" class="mode-tabs"><view id="adjustment-entry-course" class="mode-tab {{screen === 'course' ? 'active' : ''}}" data-screen="course" bindtap="enter">按课程</view><view id="adjustment-entry-day" class="mode-tab {{screen === 'day' ? 'active' : ''}}" data-screen="day" bindtap="enter">按天</view></view>
  <block wx:if="{{screen === 'course'}}">
    <block wx:if="{{step === 0}}">
      <view class="week-controls"><button id="adjustment-week-prev" size="mini" data-offset="-1" bindtap="changeWeek">上一周</button><picker id="adjustment-week-picker" range="{{weekNumbers}}" value="{{week - 1}}" bindchange="pickWeek"><view>第{{week}}周 ▾</view></picker><button id="adjustment-week-next" size="mini" data-offset="1" bindtap="changeWeek">下一周</button></view>
      <scroll-view scroll-x class="schedule-scroll" id="adjustment-week-grid"><view class="week-table">
        <view class="week-header"><view class="time-column header-time">节次</view><view wx:for="{{weekDays}}" wx:key="index" class="day-header"><view>{{item.label}}</view><view class="day-date">{{item.date}}</view></view></view>
        <view wx:for="{{weekRows}}" wx:key="period" wx:for-item="row" class="week-row"><view class="time-column period-cell"><view>{{row.period}}</view><view class="period-time">{{row.start}}</view><view class="period-time">{{row.end}}</view></view><view wx:for="{{row.cells}}" wx:key="index" wx:for-item="cell" class="day-cell">
          <view wx:for="{{cell.blocks}}" wx:key="key" wx:for-item="block" id="adjustment-course-{{block.courseIndex}}" class="course-block {{weekCourses[block.courseIndex].selected ? 'is-selected' : ''}}" style="height:{{block.height}}rpx;left:{{block.left}}%;width:{{block.width}}%;background:{{block.color}}" data-index="{{block.courseIndex}}" bindtap="selectCourse" role="button" aria-label="{{block.name}}，点击选择或取消"><view wx:if="{{weekCourses[block.courseIndex].selected}}">✓ 已选</view><view class="block-name">{{block.name}}</view><view>{{block.startSection}}–{{block.endSection}}节</view></view>
        </view></view>
      </view></scroll-view>
      <view class="card" id="adjustment-selection-summary">已选 {{groupCount}} 门教学安排，共 {{selectedCount}} 次课程</view>
    </block>
    <view wx:else class="section-title">{{step === 1 ? '选择要调整的周次' : '当前上课时间 → 新上课时间'}}</view>
    <view wx:if="{{step > 0 && currentGroup}}" class="group-switch card"><button id="adjustment-group-prev" size="mini" data-offset="-1" bindtap="changeGroup" disabled="{{groupIndex === 0}}">‹</button><view>第{{groupIndex + 1}} / {{groups.length}}门 · {{currentGroup.name}}</view><button id="adjustment-group-next" size="mini" data-offset="1" bindtap="changeGroup" disabled="{{groupIndex + 1 >= groups.length}}">›</button></view>
    <view wx:if="{{step > 0 && currentGroup}}" class="card course-summary">
      <view class="course-accent"></view><view class="course-summary-content"><view class="course-name">{{currentGroup.name}}</view><view class="summary-row">▦　{{currentGroup.selectedCount}}次实际课程已选</view><view class="summary-row">◷　周{{currentGroup.weekday}} {{currentGroup.courses.length ? ('第' + currentGroup.courses[0].startSection + '–' + currentGroup.courses[0].endSection + '节') : '请选择周次'}}</view><view class="summary-row">⌖　{{currentGroup.classroom || '教室未安排'}}</view><view class="summary-row">♙　{{currentGroup.teacher || '教师未安排'}}</view></view>
    </view>
    <view wx:if="{{step > 0 && currentGroup}}" class="card">
      <block wx:if="{{step === 1}}">
        <view class="section-title">调整范围</view><picker id="adjustment-range-{{groupIndex}}" range="{{ranges}}" value="{{currentGroup.rangeIndex}}" data-group="{{currentGroup.groupId}}" data-field="range" bindchange="groupChange"><view class="choice-row">{{ranges[currentGroup.rangeIndex]}}<text>›</text></view></picker>
        <picker wx:if="{{currentGroup.range === 'future'}}" range="{{weekNumbers}}" value="{{currentGroup.fromWeek - 1}}" data-group="{{currentGroup.groupId}}" data-field="fromWeek" bindchange="groupChange"><view class="choice-row">从第{{currentGroup.fromWeek}}周起<text>›</text></view></picker>
        <block wx:if="{{currentGroup.range !== 'selected'}}"><view class="actions"><button size="mini" data-group="{{currentGroup.groupId}}" bindtap="selectAll">全选可调整课程</button><button size="mini" data-group="{{currentGroup.groupId}}" data-clear="true" bindtap="selectAll">清空</button></view><view class="scope-grid"><button wx:for="{{currentGroup.weeks}}" wx:key="week" wx:for-item="choice" id="adjustment-scope-{{groupIndex}}-{{choice.week}}" class="{{choice.selected ? 'chosen' : ''}}" data-group="{{currentGroup.groupId}}" data-week="{{choice.week}}" bindtap="toggleScopeWeek" disabled="{{!choice.enabled}}">{{choice.selected ? '✓ ' : ''}}{{choice.week}}</button></view><view class="muted">下方列出实际有课的日期，单双周和停课按生效课表计算。</view></block>
      </block>
      <block wx:else>
        <view class="section-title">新上课时间</view><picker id="adjustment-target-mode-{{groupIndex}}" range="{{targetModes}}" value="{{currentGroup.modeIndex}}" data-group="{{currentGroup.groupId}}" data-field="mode" bindchange="groupChange"><view class="choice-row">{{targetModes[currentGroup.modeIndex]}}<text>›</text></view></picker>
        <block wx:if="{{currentGroup.mode === 'uniform'}}"><picker id="adjustment-target-weekday-{{groupIndex}}" range="{{weekdays}}" value="{{currentGroup.weekday - 1}}" data-group="{{currentGroup.groupId}}" data-field="weekday" bindchange="groupChange"><view class="choice-row">星期<text>{{weekdays[currentGroup.weekday - 1]}} ›</text></view></picker><picker id="adjustment-group-start-{{groupIndex}}" range="{{sections}}" value="{{currentGroup.targetStart - 1}}" data-group="{{currentGroup.groupId}}" data-field="targetStart" bindchange="groupChange"><view class="choice-row">时间<text>第{{currentGroup.targetStart}}节 ›</text></view></picker></block>
        <button wx:if="{{currentGroup.mode === 'dates'}}" id="adjustment-group-dates-{{groupIndex}}" class="choice-row" data-group="group:{{currentGroup.groupId}}" bindtap="openCalendar">目标日期（{{currentGroup.targetCount}}/{{currentGroup.selectedCount}}）<text>›</text></button>
      </block>
      <view class="section-title">{{step === 1 ? '实际课程 · ' : '当前上课时间 · '}}{{currentGroup.selectedCount}}次</view><template is="courses" data="{{rows: currentGroup.courses, count: currentGroup.selectedCount}}" />
    </view>
  </block>
  <block wx:if="{{screen === 'day'}}">
    <view class="mode-tabs"><view id="adjustment-day-whole" class="mode-tab {{operation === 'day' ? 'active' : ''}}" data-mode="day" bindtap="changeDayMode">整日交换</view><view id="adjustment-day-cover" class="mode-tab {{operation === 'dayCover' ? 'active' : ''}}" data-mode="dayCover" bindtap="changeDayMode">整日覆盖</view></view>
    <view wx:if="{{operation === 'day'}}" class="muted mode-hint">交换两天整张课表，节次保持原样。</view><view wx:if="{{operation === 'dayCover'}}" class="muted mode-hint">来源当天全部课程移到目标日期，目标当天原课程会被覆盖。</view>
    <view class="section-title">当前上课时间</view><button id="adjustment-source-calendar" class="choice-row" data-group="source" bindtap="openCalendar">选择来源日期（{{sources.length}}天）<text>›</text></button>
    <view wx:for="{{sourceDays}}" wx:key="date" wx:for-item="day" class="card day-card"><view class="title">{{day.label}} · 共{{day.count}}节课</view><view wx:for="{{day.courses}}" wx:key="itemKey" wx:for-item="course" class="time-block" id="adjustment-day-course-{{day.date}}-{{index}}"><view class="course-name">{{course.name}}</view><view>第{{course.startSection}}–{{course.endSection}}节</view><view class="muted">{{course.classroom}} {{course.teacher}}</view></view><view wx:if="{{day.count === 0}}" class="muted">无课</view></view>
    <view class="section-title">新上课时间</view><button id="adjustment-target-calendar" class="choice-row" data-group="target" bindtap="openCalendar">选择目标日期（{{targets.length}}天）<text>›</text></button>
    <view wx:for="{{targetDays}}" wx:key="date" wx:for-item="day" class="card"><view class="title">{{day.label}} · {{day.count}}门已有课程</view><template is="courses" data="{{rows: day.courses, count: day.count}}" /></view>
  </block>
  <block wx:if="{{(screen === 'course' && step === 2) || screen === 'day'}}"><view wx:for="{{pairs}}" wx:key="itemId" class="card"><view class="course-name">{{item.name}}</view><view>{{item.sourceDate}} 第{{item.sourceWeek}}周 {{item.sourceStart}}–{{item.sourceEnd}}节 → {{item.targetDate}} 第{{item.targetWeek}}周 {{item.targetStart}}–{{item.targetEnd}}节</view><block wx:if="{{operation !== 'day' && operation !== 'dayCover'}}"><button id="adjustment-split-{{index}}" size="mini" data-index="{{index}}" bindtap="toggleSplit">只调整部分节次 / 单独设置</button><block wx:if="{{item.split}}"><picker id="adjustment-start-{{index}}" range="{{sections}}" value="{{item.sourceStart - 1}}" data-index="{{index}}" data-field="sourceStart" bindchange="sectionChange"><view class="picker">来源开始：第{{item.sourceStart}}节</view></picker><picker id="adjustment-end-{{index}}" range="{{sections}}" value="{{item.sourceEnd - 1}}" data-index="{{index}}" data-field="sourceEnd" bindchange="sectionChange"><view class="picker">来源结束：第{{item.sourceEnd}}节</view></picker></block><picker id="adjustment-target-start-{{index}}" range="{{sections}}" value="{{item.targetStart - 1}}" data-index="{{index}}" data-field="targetStart" bindchange="sectionChange"><view class="picker">目标开始：第{{item.targetStart}}节</view></picker></block></view><view wx:if="{{validation}}" id="adjustment-validation" class="error">{{validation}}</view></block>
  <view wx:if="{{screen === 'course' && step === 0}}" class="footer"><view id="adjustment-fixed-summary" bindtap="toggleSummary">已选 {{groupCount}} 门教学安排，共 {{selectedCount}} 次课程 ▴</view></view>
  <block wx:if="{{screen === 'preview' && preview}}">
    <view>共 {{preview.pairs.length}} 项调整，将影响 {{preview.affectedCount}} 个课程实例</view><view wx:if="{{preview.ready}}" class="card"><view class="title">整批调整后的课程</view><view wx:for="{{resultCourses}}" wx:key="itemKey" class="time-block"><view class="impact">{{item.changeLabel}}</view><view>{{item.date}} 第{{item.startSection}}–{{item.endSection}}节</view><view class="course-name">{{item.name}}</view><view class="muted">{{item.teacher}} {{item.classroom}}</view></view></view><view wx:for="{{preview.batchConflicts}}" wx:key="*this" class="error">{{item}}</view>
    <view wx:for="{{preview.pairs}}" wx:key="index" class="card">
      <view class="title">配对 {{index + 1}} · {{item.pair.sourceDate}} {{operation === 'dayCover' ? '→' : '↔'}} {{item.pair.targetDate}}</view>
      <view wx:if="{{operation !== 'day' && operation !== 'dayCover' && item.conflictCount > 0}}" class="actions"><button id="adjustment-action-{{index}}-swap" class="{{item.pair.action === 'swap' ? 'chosen' : ''}}" data-index="{{index}}" data-action="swap" bindtap="chooseAction" disabled="{{busy}}">交换冲突时段</button><button id="adjustment-action-{{index}}-replace" class="{{item.pair.action === 'replace' ? 'chosen' : ''}}" data-index="{{index}}" data-action="replace" bindtap="chooseAction" disabled="{{busy}}">覆盖目标冲突部分</button></view>
      <view wx:for="{{item.labels}}" wx:key="*this" wx:for-item="label" class="impact">{{label}}</view>
      <view wx:for="{{item.conflicts}}" wx:key="itemKey" wx:for-item="covered" class="impact">覆盖移除：{{covered.name}} · 第{{covered.startSection}}–{{covered.endSection}}节</view>
      <template is="comparison" data="{{before: item.before, after: item.after, beforeCount: item.beforeCount, afterCount: item.afterCount}}" />
    </view>
    <view class="footer"><button id="adjustments-submit" type="primary" bindtap="submit" disabled="{{busy || !preview.ready}}" loading="{{busy}}">{{submitLabel}}</button></view>
  </block>
  <block wx:if="{{screen === 'history'}}">
    <view wx:if="{{!records.length}}" class="empty">本学期暂无调课记录</view>
    <view wx:for="{{records}}" wx:key="clientId" class="card"><view id="adjustment-record-{{index}}" data-index="{{index}}" bindtap="expandRecord"><view class="title">{{item.label}}</view><view>{{item.count}} 对 · {{item.sourceDate}} → {{item.targetDate}}</view><view class="muted">{{item.createdAt || '旧记录无时间信息'}} · 点击展开</view></view>
      <block wx:if="{{item.expanded}}"><view wx:if="{{!item.metadata}}" class="muted">旧记录仅保留原始操作，没有历史课程快照。</view><view wx:for="{{item.metadata.preview.pairs}}" wx:key="index" wx:for-item="pair"><view>{{pair.labels}}</view><template is="comparison" data="{{before: pair.before, after: pair.after, beforeCount: pair.beforeCount, afterCount: pair.afterCount}}" /></view><button wx:if="{{item.status === 'active'}}" id="adjustment-undo-{{index}}" data-id="{{item.clientId}}" bindtap="previewUndo" disabled="{{busy}}">预览撤销整批操作</button></block>
    </view>
  </block>
  <block wx:if="{{screen === 'restore' && restorePreview}}"><view wx:if="{{restorePreview.blockers.length}}" class="error">请先撤销以下关联的后续调课：<button wx:for="{{restorePreview.blockers}}" wx:key="*this" data-id="{{item}}" bindtap="previewUndo">{{item}}</button></view><block wx:else><template is="comparison" data="{{before: restorePreview.before, after: restorePreview.after, beforeCount: restorePreview.beforeCount, afterCount: restorePreview.afterCount}}" /><view class="footer"><button id="adjustment-undo-confirm" type="primary" bindtap="undo" disabled="{{busy}}">确认撤销整批调课</button></view></block></block>
  <view wx:if="{{summaryOpen}}" class="modal-mask"><view class="calendar"><view class="title">已选课程</view><scroll-view scroll-y class="calendar-content"><template is="courses" data="{{rows: selectedCourses, count: selectedCount}}" /></scroll-view><button id="adjustment-summary-close" bindtap="toggleSummary">返回选择</button></view></view>
  <view wx:if="{{calendar}}" class="modal-mask" id="adjustment-calendar"><view class="calendar"><view class="title">{{calendarGroup === 'source' ? '来源日期 / A组' : '目标日期'}}</view><view class="week-controls"><button id="adjustment-month-prev" size="mini" data-offset="-1" bindtap="monthChange">‹</button><text>{{month}}</text><button id="adjustment-month-next" size="mini" data-offset="1" bindtap="monthChange">›</button></view><scroll-view scroll-y class="calendar-content"><view class="calendar-grid"><text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text><button wx:for="{{calendarDays}}" wx:key="index" id="adjustment-date-{{item.date}}" class="{{item.selected ? 'chosen' : ''}}" data-date="{{item.date}}" disabled="{{!item.enabled}}" bindtap="toggleDate"><view>{{item.day || ''}}</view><view wx:if="{{item.day}}" class="calendar-count">{{item.count ? item.count + '门' : '无课'}}</view></button></view><view wx:for="{{calendarCourses}}" wx:key="date" wx:for-item="day"><view class="title">{{day.label}} · {{day.count}}门课</view><template is="courses" data="{{rows: day.courses, count: day.count}}" /></view></scroll-view><button id="adjustment-date-confirm" type="primary" bindtap="confirmDates">确定（{{calendarSelected.length}}天）</button><button id="adjustment-date-cancel" bindtap="closeCalendar">取消</button></view></view>
</view>
