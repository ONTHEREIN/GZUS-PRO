{
  "rewrites": [
    {
      "source": "/.well-known/pki-validation/fileauth.txt",
      "destination": "/fileauth-current.txt"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/pki-validation/fileauth.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
