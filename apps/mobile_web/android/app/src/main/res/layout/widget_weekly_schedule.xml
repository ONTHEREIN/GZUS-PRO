            <TextView android:id="@+id/weekly_course_1_7" style="@style/WidgetCalendarCourse" />
            <TextView android:id="@+id/weekly_course_1_8" style="@style/WidgetCalendarCourse" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/weekly_day_2" style="@style/WidgetCalendarDayHeader" />
